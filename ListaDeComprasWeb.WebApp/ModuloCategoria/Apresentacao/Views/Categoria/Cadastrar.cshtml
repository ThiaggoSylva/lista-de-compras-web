@using ListaDeComprasWeb.ModuloCategoria.Apresentacao.Models
@model CadastrarCategoriaViewModel

@{
    ViewBag.Titulo = "Cadastrar Categoria";
}

<div class="card shadow-sm">

    <div class="card-header">
        <h4>@ViewBag.Titulo</h4>
    </div>

    <div class="card-body">

        <form method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">
                </label>

                <input asp-for="Nome"
                       class="form-control" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Cor"
                       class="form-label">
                    Cor
                </label>

                <input asp-for="Cor"
                       type="color"
                       class="form-control form-control-color" />

                <span asp-validation-for="Cor"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Salvar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </div>

        </form>

    </div>

</div>

