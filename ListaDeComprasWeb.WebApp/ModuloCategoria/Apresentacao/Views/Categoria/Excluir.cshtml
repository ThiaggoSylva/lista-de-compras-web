@using ListaDeComprasWeb.ModuloCategoria.Apresentacao.Models
@model VisualizarCategoriaViewModel

@{
    ViewBag.Titulo = "Excluir Categoria";
}

<div class="card border-danger">

    <div class="card-header bg-danger text-white">
        Confirmação de Exclusão
    </div>

    <div class="card-body">

        <p>
            Deseja realmente excluir a categoria abaixo?
        </p>

        <hr />

        <dl class="row">

            <dt class="col-sm-2">
                Nome
            </dt>

            <dd class="col-sm-10">
                @Model.Nome
            </dd>

            <dt class="col-sm-2">
                Cor
            </dt>

            <dd class="col-sm-10">

                <span class="badge"
                      style="background-color:@Model.Cor">
                    @Model.Cor
                </span>

            </dd>

        </dl>

        <form asp-action="ConfirmarExclusao"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>

</div>