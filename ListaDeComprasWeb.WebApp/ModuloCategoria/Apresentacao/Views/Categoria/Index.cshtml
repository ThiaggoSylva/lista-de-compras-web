@using ListaDeComprasWeb.ModuloCategoria.Apresentacao.Models
@model List<VisualizarCategoriaViewModel>

@{
    ViewBag.Titulo = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewBag.Titulo</h2>

    <a asp-action="Cadastrar"
       class="btn btn-primary">
        Nova Categoria
    </a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Cor</th>
                        <th width="180">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>@categoria.Nome</td>

                            <td>
                                <span class="badge"
                                      style="background-color:@categoria.Cor">
                                    @categoria.Cor
                                </span>
                            </td>

                            <td>

                                <a asp-action="Editar"
                                   asp-route-id="@categoria.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Excluir"
                                   asp-route-id="@categoria.Id"
                                   class="btn btn-danger btn-sm">
                                    Excluir
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>