@using ListaDeComprasWeb.ModuloItemListaCompras.Apresentacao.Models

@model CadastrarItemListaViewModel

@{
    ViewBag.Titulo = "Adicionar Item";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h3>@ViewBag.Titulo</h3>

    </div>

    <div class="card-body">

        <form method="post">

            <input asp-for="ListaComprasId"
                   type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="ProdutoId"
                       class="form-label">
                    Produto
                </label>

                <select asp-for="ProdutoId"
                        asp-items="Model.Produtos"
                        class="form-select">

                    <option value="">
                        Selecione um produto
                    </option>

                </select>

                <span asp-validation-for="ProdutoId"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Quantidade"
                       class="form-label">
                </label>

                <input asp-for="Quantidade"
                       class="form-control" />

                <span asp-validation-for="Quantidade"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Salvar
                </button>

                <a asp-action="Index"
                   asp-route-listaId="@Model.ListaComprasId"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </div>

        </form>

    </div>

</div>
