@using ListaDeComprasWeb.ModuloItemListaCompras.Apresentacao.Models

@model VisualizarItensListaViewModel

@{
    ViewBag.Titulo = $"Itens da Lista - {Model.NomeLista}";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>@ViewBag.Titulo</h2>

    <a asp-action="Cadastrar"
       asp-route-listaId="@Model.ListaComprasId"
       class="btn btn-primary">
        Adicionar Item
    </a>

</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<div class="card mb-4">

    <div class="card-body">

        <strong>Total Estimado:</strong>

        R$ @Model.ValorTotalLista.ToString("N2")

    </div>

    <div class="mt-2">

    <strong>Total de Produtos:</strong>

    @Model.Itens.Sum(x => x.Quantidade)

    </div>

</div>

<table class="table table-striped table-hover">

    <thead>

        <tr>

            <th>Produto</th>

            <th>Categoria</th>

            <th>Quantidade</th>

            <th>Preço Unitário</th>

            <th>Valor Total</th>

            <th width="120">Ações</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Itens)
        {
            <tr>

                <td>@item.Produto</td>

                <td>@item.Categoria</td>

                <td>@item.Quantidade</td>

                <td>
                    R$ @item.PrecoUnitario.ToString("N2")
                </td>

                <td>
                    R$ @item.ValorTotal.ToString("N2")
                </td>

                <td>

                    <a asp-action="Excluir"
                       asp-route-id="@item.Id"
                       asp-route-listaId="@Model.ListaComprasId"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>

<a asp-controller="ListaCompras"
   asp-action="Index"
   class="btn btn-secondary">
    Voltar
</a>