@using ListaDeComprasWeb.ModuloListaCompras.Apresentacao.Models

@model List<VisualizarListaComprasViewModel>

@{
    ViewBag.Titulo = "Listas de Compras";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>@ViewBag.Titulo</h2>

    <a asp-action="Cadastrar"
       class="btn btn-primary">
        Nova Lista
    </a>

</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<table class="table table-striped table-hover">

    <thead>

        <tr>

            <th>Nome</th>

            <th>Data de Criação</th>

            <th>Status</th>

            <th>Total de Itens</th>

            <th>Valor Estimado</th>

            <th width="320">Ações</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var lista in Model)
        {
            <tr>

                <td>@lista.Nome</td>

                <td>@lista.DataCriacao.ToString("dd/MM/yyyy")</td>

                <td>@lista.Status</td>

                <td>@lista.TotalItens</td>

                <td>
                    R$ @lista.ValorTotal.ToString("N2")
                </td>

                <td>
                    <a asp-controller="ItemListaCompras"
                        asp-action="Index"
                        asp-route-listaId="@lista.Id"
                        class="btn btn-info btn-sm">
                        Itens
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@lista.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Excluir"
                       asp-route-id="@lista.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>