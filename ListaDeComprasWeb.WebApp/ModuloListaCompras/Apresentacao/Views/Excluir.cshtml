@using ListaDeComprasWeb.ModuloListaCompras.Apresentacao.Models

@model VisualizarListaComprasViewModel

@{
    ViewBag.Titulo = "Excluir Lista";
}

<div class="card border-danger">

    <div class="card-header bg-danger text-white">

        <h3>@ViewBag.Titulo</h3>

    </div>

    <div class="card-body">

        <p>

            Deseja realmente excluir a lista:

            <strong>@Model.Nome</strong>?

        </p>

        <form asp-action="ConfirmarExclusao"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger">
                Confirmar Exclusão
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>

</div>